@article{doukhi_deep_2021,
	title = {Deep {Reinforcement} {Learning} for {End}-to-{End} {Local} {Motion} {Planning} of {Autonomous} {Aerial} {Robots} in {Unknown} {Outdoor} {Environments}: {Real}-{Time} {Flight} {Experiments}},
