	file = {Full Text PDF:/home/dhimiter/Zotero/storage/C7AJ8Y5R/Moder et al. - 2023 - Model-based Imitation Learning for Real-time Robot Navigation in Crowds.pdf:application/pdf},
}

@misc{moder_navigating_2024,
	title = {Navigating the {Human} {Maze}: {Real}-{Time} {Robot} {Pathfinding} with {Generative} {Imitation} {Learning}},
